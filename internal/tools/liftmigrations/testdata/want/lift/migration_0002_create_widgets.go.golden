func m0002CreateWidgets(tx *sql.Tx) error {
	// The table.
	if _, err := tx.Exec(`
			CREATE TABLE widgets (
				id INT PRIMARY KEY
			)
		`); err != nil {
		return fmt.Errorf("widgets: %w", err)
	}
	_, err := tx.Exec(str.TrimSpace(widgetSQL(2))) // a trailing comment
	return err
}
