{
  "method": "Client.Finish",
  "cases": [
    {
      "name": "a failed run with every field set",
      "calls": [
        {
          "call": "Finish(\"<run-id>\", {failed, exit 1, agent_error, cost 0.0125})",
          "http": [
            {
              "request": {
                "method": "POST",
                "path": "/api/v1/agent-runs/<run-id>/finish",
                "route": "POST /api/v1/agent-runs/{id}/finish",
                "authorization": "Bearer <worker-key>",
                "content_type": "application/json",
                "body": "{\"status\":\"failed\",\"exit_code\":1,\"final_text\":\"Drafted one of three.\",\"error\":\"claude exited with status 1\",\"error_class\":\"agent_error\",\"tokens_in\":1200,\"tokens_out\":340,\"cost_usd\":0.0125}"
              },
              "response": {
                "status": 200,
                "body": "{\"id\":\"<run-id>\",\"status\":\"failed\"}\n"
              }
            }
          ],
          "returned": null,
          "error": null
        }
      ]
    },
    {
