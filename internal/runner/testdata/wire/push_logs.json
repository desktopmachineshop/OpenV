                "route": "POST /api/v1/agent-runs/{id}/logs",
                "authorization": "Bearer <worker-key>",
                "content_type": "application/json",
                "body": "{\"entries\":[],\"partial_text\":\"\"}"
              },
              "response": {
                "status": 200,
                "body": "{\"cancel_requested\":true,\"status\":\"running\"}\n"
              }
            }
          ],
          "returned": {
            "cancel_requested": true,
            "status": "running"
          },
          "error": null
        }
      ]
    },
