{
  "about": "The production bundle's shape (refactor plan S12b, invariant I20), written and checked by scripts/bundle-check.mjs after npm run build: where each dependency in package.json lands (entry: the entry chunk or a chunk it imports statically, loaded on every page; lazy: only chunks loaded through import()), and whether each module the app loads through import() is still a dynamic entry. A golden: change it only in a pull request that means to change the bundle.",
  "regenerate": "cd frontend && npm run build && UPDATE_BUNDLE_SHAPE=1 node scripts/bundle-check.mjs",
  "dependencies": {
    "ag-grid-community": "lazy",
    "ag-grid-react": "lazy",
    "ajv": "not in the build",
    "axios": "entry",
