    "cytoscape-react": "not in the build",
    "react": "entry",
    "react-dom": "entry",
    "react-markdown": "entry",
    "react-router-dom": "entry",
    "remark-gfm": "entry",
    "typescript": "not in the build",
    "zustand": "entry"
  },
  "lazyPages": {
    "src/site/Customers.tsx": "dynamic entry",
    "src/site/Demos.tsx": "dynamic entry",
    "src/site/Faq.tsx": "dynamic entry",
    "src/site/HowItWorks.tsx": "dynamic entry",
    "src/site/OpenSourceProjects.tsx": "dynamic entry",
    "src/site/WhitePapers.tsx": "dynamic entry",
    "src/views/ActivityLog.tsx": "dynamic entry",
    "src/views/BaselineCompare.tsx": "dynamic entry",
    "src/views/CrewBuilder.tsx": "dynamic entry",
    "src/views/ImpactView.tsx": "dynamic entry",
    "src/views/Landing.tsx": "dynamic entry",
    "src/views/ManualView.tsx": "dynamic entry",
    "src/views/ModuleView.tsx": "dynamic entry",
    "src/views/PlatformAdmin.tsx": "dynamic entry",
    "src/views/ReviewQueue.tsx": "dynamic entry",
    "src/views/SharedProjectView.tsx": "dynamic entry",
    "src/views/TestRunView.tsx": "dynamic entry",
    "src/views/TraceabilityMatrix.tsx": "dynamic entry",
    "src/views/WhatsNew.tsx": "dynamic entry"
  }
}
