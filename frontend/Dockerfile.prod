# Base image policy: pin to specific minor-version tags (not `latest` or
# bare-major tags, not sha digests). Pinned tags still receive OS-package
# security rebuilds from upstream; bump versions here deliberately.

# Build stage
FROM node:20.20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci --legacy-peer-deps

# Copy source files
COPY . .

# API base URL baked into the static bundle at build time.
# Pass --build-arg REACT_APP_API_URL=https://your-host:8080 (see docker-compose.prod.yml).
ARG REACT_APP_API_URL=""
ENV REACT_APP_API_URL=$REACT_APP_API_URL

# Build the React app
RUN npm run build

# Production stage (nginx 1.30 = current stable branch; the tag floats only
# across 1.30.x patch releases)
FROM nginx:1.30-alpine

# Install curl for health checks
RUN apk --no-cache add curl

# Copy custom nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf

# Copy built assets from builder stage
COPY --from=builder /app/build /usr/share/nginx/html

# Run as the unprivileged nginx user that ships with the base image.
# Give it ownership of the paths nginx writes to. (Do not add a custom
# user with a hardcoded uid/gid: current nginx:alpine images already
# ship gid 101, which made `addgroup -g 101` fail — see PR #50/#75.)
RUN chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/log/nginx && \
    touch /var/run/nginx.pid && \
    chown nginx:nginx /var/run/nginx.pid

# nginx listens on 8080 (see nginx.conf) so it can bind without root
EXPOSE 8080

# Switch to non-root user
USER nginx

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
