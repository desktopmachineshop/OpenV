# Base image policy: pin to specific minor-version tags (not `latest` or
# bare-major tags, not sha digests). Pinned tags still receive OS-package
# security rebuilds from upstream; bump versions here deliberately.

# Build stage
FROM node:20.20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci --legacy-peer-deps

# Copy source files
COPY . .

# API base URL baked into the static bundle at build time. Leave it EMPTY
# (the default) to have the app call /api on its own origin, which nginx
# proxies to the API (API_UPSTREAM at run time) — the session cookie is then
# first-party and works on Safari/iOS. Set it only for a split deployment
# where the browser talks to the API's own origin directly.
ARG REACT_APP_API_URL=""
ENV REACT_APP_API_URL=$REACT_APP_API_URL

# The content security policy allows scripts from the app's own origin only,
# so the runtime chunk must be a file rather than the inline script CRA
# writes into index.html by default.
ENV INLINE_RUNTIME_CHUNK=false

# Build the React app
RUN npm run build

# Production stage (nginx 1.30 = current stable branch; the tag floats only
# across 1.30.x patch releases)
FROM nginx:1.30-alpine

# Install curl for health checks
RUN apk --no-cache add curl

# Copy custom nginx configuration and the security headers it includes in
# every location. The content security policy names the API origin the app
# was built against, so the same build argument is substituted in here; when
# it is empty the app only ever talks to its own origin ('self').
ARG REACT_APP_API_URL=""
COPY nginx.conf /etc/nginx/nginx.conf
COPY security-headers.conf /etc/nginx/security-headers.conf
# /api/ proxy: the entrypoint script rewrites the include from API_UPSTREAM
# and the container's DNS at start; the copied default keeps `nginx -t`
# meaningful here and covers a compose stack whose API service is `api`.
COPY docker-entrypoint.d/40-openv-api-proxy.sh /docker-entrypoint.d/40-openv-api-proxy.sh
COPY openv-nginx/api-proxy.conf /etc/nginx/openv/api-proxy.conf
RUN api_origin="${REACT_APP_API_URL%/}" && \
    if [ -n "$api_origin" ]; then \
        sed -i "s|__API_ORIGIN__|${api_origin}|g" /etc/nginx/security-headers.conf; \
    else \
        sed -i "s| __API_ORIGIN__||g" /etc/nginx/security-headers.conf; \
    fi && \
    chmod +x /docker-entrypoint.d/40-openv-api-proxy.sh && \
    nginx -t

# Copy built assets from builder stage
COPY --from=builder /app/build /usr/share/nginx/html

# Run as the unprivileged nginx user that ships with the base image.
# Give it ownership of the paths nginx writes to. (Do not add a custom
# user with a hardcoded uid/gid: current nginx:alpine images already
# ship gid 101, which made `addgroup -g 101` fail — see PR #50/#75.)
RUN chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/log/nginx /etc/nginx/openv && \
    touch /var/run/nginx.pid && \
    chown nginx:nginx /var/run/nginx.pid

# nginx listens on 8080 (see nginx.conf) so it can bind without root
EXPOSE 8080

# Switch to non-root user
USER nginx

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
